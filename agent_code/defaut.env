# Configuration d'agent_code. Lue par agent_code, jamais par les agents.
# Emplacements (le premier trouvé gagne) : $AGENT_CODE_CONFIG, <code d'agent_code>/.env, ~/.config/agent_code/agent_code.env
# Les variables d'environnement déjà définies sont prioritaires sur ce fichier.

# --- Serveur Ollama ---------------------------------------------------------
AGENT_CODE_OLLAMA_URL=http://localhost:11434
# Ollama derrière un reverse proxy avec authentification « Bearer » :
#AGENT_CODE_OLLAMA_API_KEY=
# Ollama distant mais maîtrisé (docker compose, LAN, VPN) : supprime l'alerte de confidentialité
#AGENT_CODE_OLLAMA_DE_CONFIANCE=true

# --- Modèle -----------------------------------------------------------------
# Un seul modèle pour tous les rôles (deux modèles = Ollama les alterne en mémoire, très lent).
# Il doit gérer les appels d'outils (capacité « tools »). Avec 32 Go de RAM : qwen3-coder:30b.
AGENT_CODE_MODELE=qwen3-coder:30b
#AGENT_CODE_MODELE_REFLEXION=     # optionnel : modèle différent pour revue / cadrage / veille (missions)
AGENT_CODE_CONTEXTE=32768          # mémoire de travail du modèle, en tokens (16384 si la RAM manque)
AGENT_CODE_TEMPERATURE_CODE=0.3
AGENT_CODE_TEMPERATURE_REFLEXION=0.5
AGENT_CODE_GARDER_MODELE=30m       # durée pendant laquelle Ollama garde le modèle chargé après usage

# --- Session interactive ------------------------------------------------------
AGENT_CODE_MODE=normal             # normal : tu valides chaque modification · auto : sans validation · lecture
AGENT_CODE_MAX_ETAPES=50           # allers-retours max avec le modèle par demande (anti-boucle)

# --- Garde-fous ----------------------------------------------------------------
AGENT_CODE_TIMEOUT_CMD=120         # secondes max par commande shell
AGENT_CODE_TIMEOUT_LLM=900         # secondes max pour une réponse du modèle
AGENT_CODE_TIMEOUT_MISSION=0       # secondes max pour une mission entière (0 = illimité ; conseillé en cron : 3600)
AGENT_CODE_MAX_SORTIE=12000        # caractères max renvoyés par un outil au modèle

# --- Fonctionnalités -------------------------------------------------------------
AGENT_CODE_WEB=true                # recherche web (sous-agent « chercheur », missions veille/projet)
AGENT_CODE_AUTO_APPROUVER_SURES=true   # ls, git status, grep... sans confirmation
#AGENT_CODE_VERBOSE=true           # false : missions sans le texte des agents (comme --silencieux)

# --- Approbations automatiques (utile sans surveillance : cron, CI, serveur) ---
# Par défaut, sans terminal, tout ce qui demande une validation est REFUSÉ.
# Les commandes bloquées (sudo, rm -rf, git push...) restent bloquées quoi qu'il arrive.
#AGENT_CODE_AUTORISER_TESTS=true                        # Lancer_Tests sans validation (exécute le code du projet !)
#AGENT_CODE_COMMANDES_AUTORISEES=pytest, npm run lint, make check   # préfixes exacts, séparés par des virgules
#AGENT_CODE_AUTORISER_PAGES_WEB=false                   # Lire_Page_Web sans validation
